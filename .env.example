# Copy to .env and fill in. Never commit .env.

# --- LLM for planner and sub-agents (any OpenAI-compatible endpoint; --backend api) ---
OPENAI_API_KEY=
OPENAI_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=qwen/qwen3-32b

# --- Embeddings for the semantic scheduler ---
EMBEDDING_API_KEY=
EMBEDDING_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=

# --- Search / crawling tools ---
SERPER_API_KEY=
JINA_API_KEY=

# --- Answer grading (coact.evaluation.judge, baselines/*/judge.py) ---
OPENROUTER_API_KEY=
# JUDGE_API_KEY=            # overrides OPENROUTER_API_KEY for coact.evaluation.judge
# JUDGE_MODEL=openai/gpt-5-mini
# JUDGE_BASE_URL=https://openrouter.ai/api/v1

# --- Baselines only (see baselines/README.md) ---
# OPENAI_BASE_URL=
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=
